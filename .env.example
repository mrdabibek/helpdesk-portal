# BACKEND: Render / Koyeb secrets and settings
NODE_ENV=development
PORT=3002
HOST=127.0.0.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Production: NODE_ENV=production, HOST=0.0.0.0; Render supplies PORT.
# Exact frontend origins, comma-separated; no wildcard or trailing slash.
CORS_ORIGINS=http://localhost:3002
# Production example: CORS_ORIGINS=https://yordam.vercel.app

# FRONTEND BUILD ONLY: Vercel Environment Variables
# Public backend origin, not a secret. Mandatory for Vercel/production builds.
BACKEND_URL=
# Example: BACKEND_URL=https://yordam-api.onrender.com

# DATABASE_URL and JWT_SECRET are not used by this prototype.
# Tickets use browser localStorage; files use IndexedDB. No database/auth backend.
